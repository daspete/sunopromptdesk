# Local / development config (copy to .env). Production uses .env.production (see .env.production.example).
# Plausible analytics (loaded only after the visitor accepts the consent bar).
# Leave VITE_PLAUSIBLE_DOMAIN empty to disable analytics and the consent bar entirely.
VITE_PLAUSIBLE_DOMAIN=promptdesk.example.com
# Optional: self-hosted Plausible script URL
# VITE_PLAUSIBLE_SRC=https://plausible.example.com/js/script.js
VITE_SITE_URL=https://promptdesk.example.com
